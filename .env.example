# Copiar para .env e preencher.  (cp .env.example .env)

# Gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Domínio(s) pelo(s) qual(is) a app é acedida (separados por vírgulas)
DJANGO_ALLOWED_HOSTS=gestao.exemplo.pt
# URL completo, com https, tal como servido pelo reverse proxy
DJANGO_CSRF_TRUSTED_ORIGINS=https://gestao.exemplo.pt
# Pôr a false só se aceder por HTTP simples (sem reverse proxy com HTTPS)
DJANGO_SECURE_COOKIES=true
TZ=Europe/Lisbon

# Primeiro utilizador admin (criado no arranque se não existir; pode apagar depois)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Base de dados (use só letras e números na password, vai dentro de um URL)
POSTGRES_DB=hosting
POSTGRES_USER=hosting
POSTGRES_PASSWORD=

# Porta exposta no LXC (o reverse proxy aponta para http://<ip-do-lxc>:8000)
WEB_BIND=0.0.0.0
WEB_PORT=8000

# Intervalo do agendador em segundos (cobranças, notificações, sync Proxmox)
SCHEDULER_INTERVAL=3600
